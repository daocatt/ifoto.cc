# ==========================================
# ifoto.cc 环境配置文件
# ==========================================

# 1. 运行模式: local (本地免登录模式) | online (非本地/线上账户模式)
APP_MODE=local

# 2. Docker Compose 启用的服务 Profile:
# - 本地模式 (local): 保持注释或留空，此时 docker-compose 绝不拉取和启动 Postgres 数据库容器！
# - 线上模式 (online): 取消下方注释，docker-compose 会自动拉起 Postgres 数据库容器
# COMPOSE_PROFILES=online

# 3. 服务运行端口
PORT=3000

# 4. 访问域名 (用于生成房间邀请链接和二维码，例如 https://ifoto.cc)
APP_DOMAIN=http://localhost:3000

# 5. 是否开放用户公开注册 (true: 开放注册, false: 仅管理员可登录或邀请)
ALLOW_REGISTER=true

# 6. JWT 鉴权密钥 (线上模式必填，请务必修改为强随机字符串)
JWT_SECRET=ifoto_super_secret_jwt_key_2026_change_me_please

# 7. PostgreSQL 数据库配置 (仅在 COMPOSE_PROFILES=online 时生效)
DATABASE_URL=postgres://ifoto_user:ifoto_secret_password@postgres:5432/ifoto_db
POSTGRES_DB=ifoto_db
POSTGRES_USER=ifoto_user
POSTGRES_PASSWORD=ifoto_secret_password
